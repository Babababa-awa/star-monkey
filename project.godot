;   param=value ; assign values to parameters

config_version=5

[application]

config/name="StarMonkey"
run/main_scene="uid://dojby5sob6543"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://qf2yy152uec3"

[display]

window/size/viewport_width=640
window/size/viewport_height=480
window/size/mode=3
window/stretch/mode="viewport"

[file_customization]

folder_colors={
"res://assets/": "orange",
"res://materials/": "teal",
"res://models/": "pink",
"res://resources/": "red",
"res://scenes/": "green",
"res://scripts/": "yellow",
"res://shaders/": "teal"
}

